"""HTTP gateway entry point (FastAPI + IntentRouter)."""

import logging
from contextlib import asynccontextmanager

import uvicorn

from kntgraph.api import create_app
from kntgraph.api.auth import RedisAPIKeyVerifier
from kntgraph.agents.tools.protocol import ToolRegistry
from kntgraph.stream.event_log import EventLog
from kntgraph.infra.redis._event_log import RedisEventLogAdapter
from kntgraph.infra.redis._pool import create_redis_pool
from kntgraph.tools.router import ToolRouter
from kntgraph.tools.manager import WorkerManager

# Replace with the context's dispatcher factory.
# from src.{{ project_name }}.contexts.sales.dispatcher import build_sales_dispatcher

# 1. Global variables for background components (the lifespan
#    task scheduler reads them at startup).
worker_manager = None
# sales_dispatcher = None


@asynccontextmanager
async def lifespan(app):
    global worker_manager
    # global sales_dispatcher
    logging.info("[Lifespan] Starting Background Dispatchers and Workers...")
    # AWAIT ``start()`` so initialization errors (e.g. a failing
    # ``ProcessPoolExecutor`` spawn, or Redis refusing
    # ``xgroup_create``) surface in the uvicorn startup log.
    # Fire-and-forget ``asyncio.create_task`` swallowed those
    # exceptions inside an orphan task; the process would
    # stay up with no events flowing and no error in the log.
    await worker_manager.start()
    # await sales_dispatcher.start()
    try:
        yield
    finally:
        logging.info("[Lifespan] Stopping Background components...")
        # await sales_dispatcher.stop()
        await worker_manager.stop()


def build_monolith():
    global worker_manager
    # global sales_dispatcher

    redis = create_redis_pool().client
    log = EventLog(RedisEventLogAdapter(client=redis))

    tool_router = ToolRouter(redis)
    worker_manager = WorkerManager(redis=redis, event_log=log)

    # Wire context dispatchers here. The ``log``, ``redis`` and
    # ``tool_router`` are passed to the ``ReactiveDispatcher``
    # constructor so the dispatcher can route tool invocations
    # through the worker pool without re-reading the Redis pool.
    # sales_dispatcher = build_sales_dispatcher(log, redis, tool_router)

    # Configure the API Gateway (Intent Router).
    registry = ToolRegistry()
    verifier = RedisAPIKeyVerifier(redis)

    app = create_app(log=log, registry=registry, verifier=verifier)
    app.router.lifespan_context = lifespan
    return app


app = build_monolith()


if __name__ == "__main__":
    uvicorn.run("main:app", host="0.0.0.0", port=8000, reload=True)


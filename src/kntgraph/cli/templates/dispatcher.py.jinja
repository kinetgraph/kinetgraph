from kntgraph.infra.config import fresh_settings
from kntgraph.runner import ReactiveDispatcher, Runner
from kntgraph.security.principal import Principal, PrincipalLevel
from kntgraph.stream.event_log import EventLog
from kntgraph.tools.acl import default_acl
from kntgraph.tools.manager import WorkerManager


def build_{{ context_name }}_dispatcher(
    log: EventLog,
    redis = None,
    tool_router = None,
) -> ReactiveDispatcher:
    """
    Orchestrates the ReactiveDispatcher for the entire '{{ context_name }}' context.

    The context's agents are **declared**, not wired: each
    ``AgentDefinition`` derives its own runtime, and
    ``install()`` registers it here (ADR-088). The dispatcher
    never learns what an agent is -- it only receives systems
    and projections.

    The ``log``, ``redis`` (optional) and ``tool_router`` (optional)
    are threaded through to the dispatcher so tool invocations
    can route through the worker pool without re-reading the
    Redis pool. Both are optional; the dispatcher only requires
    ``log`` (the dispatcher will instantiate its own Redis
    pool internally when ``redis`` is None).
    """

    # 1. Resolve the Redis key namespace prefix (ADR-076).
    # Read once at process boot from ``Settings`` and
    # thread it through every component that writes a
    # Redis key, so two services sharing one Redis do
    # not cross-talk at the tool-queue boundary (the
    # pre-fix gap closed in DEBT §2.35).
    key_prefix = fresh_settings().redis_key_prefix

    # 2. Register the context's tools via the canonical
    # ``WorkerManager`` path (ADR-066 §3.1). Each tool is
    # registered with ``acl=default_acl()`` for the framework
    # baseline (``Role.agent``, tenant-unpinned); tighten per
    # tool with ``ToolACL(tenant_pinned=True, ...)`` for
    # tenant-scoped tools. The legacy ``ToolRegistry`` was
    # removed in v0.18.
    #
    # Note: ``WorkerManager`` is the orchestrator that runs the
    # tools in a process pool; the dispatcher only sees the
    # ``tool.<name>.requested`` events the systems emit.
    worker_manager = WorkerManager(
        redis=redis,
        event_log=log,
        key_prefix=key_prefix,
    )
{{ tool_registrations }}
    # 3. Create the dispatcher.
    dispatcher = ReactiveDispatcher(
        log=log,
        systems=[],
        redis=redis,
        tool_router=tool_router,
        key_prefix=key_prefix,
    )

    # 4. Install the declared agents. The ``Principal`` is the
    # runtime credential the agents act under -- it is never
    # stored in a declaration (ADR-088 §2.4). The scaffold
    # derives the tenant from the context name; a deployment
    # that resolves the tenant per request builds its own.
{{ agent_installs }}
    return dispatcher


{% if with_supervisor %}
def build_{{ context_name }}_supervisor_runner(
    log: EventLog,
    tick_interval: float = 1.0,
) -> Runner:
    """
    Builds the cyclic Runner for the '{{ context_name }}' context.

    The Runner hosts the **supervisor** systems that observe
    long-running state (e.g. timeouts, retries) and re-emit
    corrective events. The ReactiveDispatcher handles the
    happy-path latency-sensitive flow; the Runner handles the
    SLA-guaranteed reconciliation flow.

    The two are independent: the supervisor can run without the
    dispatcher (test scenario) and the dispatcher can run without
    the supervisor (read-only replay). The two-layer pattern is
    "ADR-004" in the SDK (cyclic processes for retries).
    """
    # The supervisor observes long-running state. Its systems are
    # cyclic by nature, so they are wired here rather than
    # derived from an agent declaration.
    supervisor_systems = []
    return Runner(
        log=log,
        cyclic_systems=supervisor_systems,
        tick_interval=tick_interval,
    )


def build_{{ context_name }}_dispatcher_with_supervisor(
    log: EventLog,
    redis = None,
    tool_router = None,
    tick_interval: float = 1.0,
) -> tuple[ReactiveDispatcher, Runner]:
    """
    Convenience helper: build the dispatcher and the supervisor
    together (the canonical "two-layer" wiring). Returns the
    dispatcher first, the runner second.
    """
    dispatcher = build_{{ context_name }}_dispatcher(
        log=log, redis=redis, tool_router=tool_router,
    )
    supervisor = build_{{ context_name }}_supervisor_runner(
        log=log, tick_interval=tick_interval,
    )
    return dispatcher, supervisor

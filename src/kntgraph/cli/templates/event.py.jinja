from typing import Any, TypedDict
from uuid import UUID

from kntgraph.core.event import Event
from kntgraph.core.event.correlation import correlation_middleware


class {{ camel_case_name }}Payload(TypedDict):
    """
    Payload for the {{ camel_case_name }} event.

    Must be pure data (JSON-serialisable) per ADR-037. Nested
    ``TypedDict`` shapes are allowed; Pydantic models are not
    (events are emitted before the EventLog validates the
    payload).
    """
    # example_field: str
    pass


def {{ event_name }}(
    agent_id: str,
    data: {{ camel_case_name }}Payload,
    causation_id: UUID | None = None,
    correlation: Any = None,
) -> Event:
    """
    Factory for the ``{{ event_type }}`` event.

    The ``correlation`` parameter accepts the optional
    ``CorrelationContext``; when omitted, the factory falls
    back to ``correlation_middleware.current()`` so the event
    is automatically tied to the ambient request scope.
    """
    return Event.domain_from(
        agent_id=agent_id,
        type="{{ event_type }}",
        data=data,  # type: ignore[arg-type]
        causation_id=causation_id,
        correlation=correlation or correlation_middleware.current(),
    )

from kntgraph.concordos.saga import (
    WorkflowSagaConcordo,
    SagaConfig,
    SagaStepConfig,
)


{{ concordo_name }} = WorkflowSagaConcordo(SagaConfig(
    name="{{ saga_name }}",
    saga_timeout_ms={{ timeout_ms }},
    steps=(
{% for step in steps %}
        SagaStepConfig(
            name="{{ step.name }}",
            tool_name="{{ step.tool }}",
        ),
{% endfor %}
    ),
))
